{
  "name": "flathub-activitypub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:css": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "build:assets": "pnpm build:css && tsc -p tsconfig.browser.json",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "fmt": "prettier --write ."
  },
  "dependencies": {
    "@fedify/cfworkers": "^2.4.5",
    "@fedify/fedify": "^2.4.5",
    "@fedify/vocab": "^2.4.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^24.0.0",
    "miniflare": "5.20261101.0-beta",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
